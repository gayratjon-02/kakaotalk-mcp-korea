{
  "name": "kakaotalk-mcp-korea",
  "version": "0.1.0",
  "description": "MCP server for KakaoTalk on macOS (unofficial): read chats, files and pictures from the local database, send and manage messages through the app",
  "type": "module",
  "bin": {
    "kakaotalk-mcp-korea": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/test",
    "!dist/bin",
    "src/native",
    "scripts/build-native.mjs",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-native.mjs",
    "build:release": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "postinstall": "node scripts/build-native.mjs --soft",
    "prepublishOnly": "npm test && npm run build:release"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kakaotalk",
    "kakao",
    "macos",
    "accessibility",
    "claude",
    "ai-agents",
    "chat"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "plist": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/plist": "^3.0.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gayratjon-02/kakaotalk-mcp-korea.git"
  },
  "author": "gayratjon-02",
  "homepage": "https://github.com/gayratjon-02/kakaotalk-mcp-korea#readme",
  "bugs": {
    "url": "https://github.com/gayratjon-02/kakaotalk-mcp-korea/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
