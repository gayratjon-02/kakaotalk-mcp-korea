{
  "name": "kakaotalk-mcp-korea",
  "version": "0.1.0",
  "description": "MCP server and CLI for KakaoTalk on macOS — read chats from the local database and send messages via Accessibility",
  "type": "module",
  "bin": {
    "kakaotalk-mcp-korea": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run build:native",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "build:native": "mkdir -p dist/bin && { [ dist/bin/kakao-ax -nt src/native/kakao-ax.swift ] || swiftc -O -swift-version 5 src/native/kakao-ax.swift -o dist/bin/kakao-ax; }"
  },
  "keywords": [
    "mcp",
    "kakaotalk",
    "macos",
    "accessibility"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "plist": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/plist": "^3.0.5",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gayratjon-02/kakaotalk-mcp-korea.git"
  },
  "author": "gayratjon-02"
}
